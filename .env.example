# ==============================================================================
# Local Development Environment Configuration
# Copy this file to .env or .env.local to customize your local settings.
# ==============================================================================

# Directory where workspace data (projects, config, db, cache) is persisted.
# Defaults to ./data in the project root if omitted or left blank.
DATA_DIR=

# Workspace authentication password (default: password)
WORKSPACE_PASSWORD=password

# OpenRouter API Key for AI features (chat, models, reviewer studio)
OPENROUTER_API_KEY=

# Optional local / self-hosted OpenAI-compatible model server (e.g., Ollama, vLLM, LM Studio)
LOCAL_MODEL_BASE_URL=http://localhost:11434/v1
LOCAL_API_KEY=

# Optional scholarly & reference integrations
ZOTERO_API_KEY=
UNPAYWALL_EMAIL=

# TeX compilation limits
COMPILE_TIMEOUT_SECONDS=60
COMPILE_MEMORY_LIMIT_MB=1024
